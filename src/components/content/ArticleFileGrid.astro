---
interface Props {
  entries: { file: string; purpose: string }[];
}

const { entries } = Astro.props;
---

<dl class="file-grid">
  {entries.map(({ file, purpose }) => (
    <div class="file-row">
      <dt><code>{file}</code></dt>
      <dd>{purpose}</dd>
    </div>
  ))}
</dl>

<style>
  .file-grid {
    margin: var(--space-4) 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .file-row {
    display: grid;
    grid-template-columns: minmax(12rem, 1fr) 3fr;
    gap: var(--space-4);
    padding: var(--space-4);
  }

  .file-row + .file-row {
    border-top: 1px solid var(--color-border);
  }

  dt, dd {
    margin: 0;
    min-width: 0;
  }

  @media (max-width: 40rem) {
    .file-row {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>
